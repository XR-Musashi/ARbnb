# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (Supabase connection string or local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/arbnb?schema=public"

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret used to sign guest session tokens
SESSION_SECRET=change-me-to-a-long-random-string

# File storage (Supabase Storage bucket name for floor plans)
STORAGE_BUCKET=floor-plans

# CORS – comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173
